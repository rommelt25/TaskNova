APP_NAME=TaskNova
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=
FRONTEND_URL=

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_FOREIGN_KEYS=true

CACHE_STORE=database
DB_CACHE_CONNECTION=
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_CONNECTION=
DB_CACHE_LOCK_TABLE=cache_locks
CACHE_PREFIX=tasknova_cache

QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_BATCH_TABLE=job_batches
DB_FAILED_JOBS_TABLE=failed_jobs
QUEUE_FAILED_DRIVER=database-uuids

FILESYSTEM_DISK=public

CORS_ALLOWED_ORIGINS=
CORS_MAX_AGE=0

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

RUN_MIGRATIONS=true
MIGRATION_MAX_ATTEMPTS=30
CACHE_CONFIGURATION=true
SEED_DEMO_DATA=false
